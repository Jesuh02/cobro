# ==============================================================================
# Evolution API (WhatsApp Gateway) - Variables de Entorno
# ==============================================================================

# Puerto público donde escuchará la API
PORT=8080

# URL pública o local del servidor Evolution API
SERVER_URL=http://localhost:8080

# Clave secreta global para proteger los endpoints REST de Evolution API
# Debe coincidir con EVOLUTION_API_KEY en backend/.env
AUTHENTICATION_API_KEY=cobrod-secure-evolution-key

# Nombre de la instancia principal de WhatsApp para Cobro
EVOLUTION_INSTANCE_NAME=cobrod

# Configuración de Base de Datos PostgreSQL interna
POSTGRES_USER=evolution
POSTGRES_PASSWORD=evolution_secret_password
POSTGRES_DB=evolution

# URI de conexión a la base de datos para Evolution API
DATABASE_CONNECTION_URI=postgresql://evolution:evolution_secret_password@evolution-db:5432/evolution?schema=public

# Persistencia optimizada (desactivar almacenamiento innecesario de mensajes en el gateway)
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_HISTORIC=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_CONTACTS=false

# Parámetros de conexión de WhatsApp
QRCODE_LIMIT=30

