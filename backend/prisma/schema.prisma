generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

model Moneda {
  codigoMoneda String @id @map("codigo_moneda") @db.Char(3)
  nombre       String @db.VarChar(80)
  simbolo      String @db.VarChar(8)
  decimales    Int    @default(2) @db.SmallInt

  creditos            Credito[]
  cajasMenores        CajaMenor[]
  gastos              Gasto[]
  pagos               Pago[]
  presupuestosPeriodo PresupuestoPeriodo[]

  @@map("moneda")
  @@schema("public")
}

model EstadoUsuario {
  estadoUsuarioId Int    @id @default(autoincrement()) @map("estado_usuario_id") @db.SmallInt
  codigo          String @unique @db.VarChar(30)
  nombre          String @db.VarChar(80)

  usuarios Usuario[]

  @@map("estado_usuario")
  @@schema("public")
}

model Rol {
  rolId  Int    @id @default(autoincrement()) @map("rol_id") @db.SmallInt
  codigo String @unique @db.VarChar(30)
  nombre String @db.VarChar(80)

  usuarios UsuarioRol[]
  recursos RolRecurso[]

  @@map("rol")
  @@schema("public")
}

model Recurso {
  recursoId     Int      @id @default(autoincrement()) @map("recurso_id") @db.SmallInt
  codigo        String   @unique @db.VarChar(60)
  nombre        String   @db.VarChar(120)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  roles RolRecurso[]

  @@map("recurso")
  @@schema("public")
}

model RolRecurso {
  rolId     Int      @map("rol_id") @db.SmallInt
  recursoId Int      @map("recurso_id") @db.SmallInt
  asignadoEn DateTime @default(now()) @map("asignado_en") @db.Timestamptz(6)

  rol     Rol     @relation(fields: [rolId], references: [rolId], onDelete: Cascade)
  recurso Recurso @relation(fields: [recursoId], references: [recursoId], onDelete: Cascade)

  @@id([rolId, recursoId])
  @@map("rol_recurso")
  @@schema("public")
}

model EstadoCliente {
  estadoClienteId Int    @id @default(autoincrement()) @map("estado_cliente_id") @db.SmallInt
  codigo          String @unique @db.VarChar(30)
  nombre          String @db.VarChar(80)

  clientes Cliente[]

  @@map("estado_cliente")
  @@schema("public")
}

model TipoDocumento {
  tipoDocumentoId Int    @id @default(autoincrement()) @map("tipo_documento_id") @db.SmallInt
  codigo          String @unique @db.VarChar(30)
  nombre          String @db.VarChar(80)

  documentos ClienteDocumento[]

  @@map("tipo_documento")
  @@schema("public")
}

model TipoContacto {
  tipoContactoId Int    @id @default(autoincrement()) @map("tipo_contacto_id") @db.SmallInt
  codigo         String @unique @db.VarChar(30)
  nombre         String @db.VarChar(80)

  contactos ClienteContacto[]

  @@map("tipo_contacto")
  @@schema("public")
}

model TipoDireccion {
  tipoDireccionId Int    @id @default(autoincrement()) @map("tipo_direccion_id") @db.SmallInt
  codigo          String @unique @db.VarChar(30)
  nombre          String @db.VarChar(80)

  direcciones ClienteDireccion[]

  @@map("tipo_direccion")
  @@schema("public")
}

model EstadoRuta {
  estadoRutaId Int    @id @default(autoincrement()) @map("estado_ruta_id") @db.SmallInt
  codigo       String @unique @db.VarChar(30)
  nombre       String @db.VarChar(80)

  rutas Ruta[]

  @@map("estado_ruta")
  @@schema("public")
}

model FrecuenciaPago {
  frecuenciaPagoId Int    @id @default(autoincrement()) @map("frecuencia_pago_id") @db.SmallInt
  codigo           String @unique @db.VarChar(30)
  nombre           String @db.VarChar(80)
  diasIntervalo    Int    @map("dias_intervalo") @db.SmallInt

  creditos Credito[]

  @@map("frecuencia_pago")
  @@schema("public")
}

model EstadoCredito {
  estadoCreditoId Int    @id @default(autoincrement()) @map("estado_credito_id") @db.SmallInt
  codigo          String @unique @db.VarChar(30)
  nombre          String @db.VarChar(80)

  creditos Credito[]

  @@map("estado_credito")
  @@schema("public")
}

model EstadoCuota {
  estadoCuotaId Int    @id @default(autoincrement()) @map("estado_cuota_id") @db.SmallInt
  codigo        String @unique @db.VarChar(30)
  nombre        String @db.VarChar(80)

  cuotas CreditoCuota[]

  @@map("estado_cuota")
  @@schema("public")
}

model MedioPago {
  medioPagoId Int    @id @default(autoincrement()) @map("medio_pago_id") @db.SmallInt
  codigo      String @unique @db.VarChar(30)
  nombre      String @db.VarChar(80)

  pagos Pago[]

  @@map("medio_pago")
  @@schema("public")
}

model TipoMovimientoCaja {
  tipoMovimientoCajaId Int    @id @default(autoincrement()) @map("tipo_movimiento_caja_id") @db.SmallInt
  codigo               String @unique @db.VarChar(30)
  nombre               String @db.VarChar(80)
  naturaleza           String @db.Char(1)

  movimientos CajaMenorMovimiento[]

  @@map("tipo_movimiento_caja")
  @@schema("public")
}

model CategoriaGasto {
  categoriaGastoId Int     @id @default(autoincrement()) @map("categoria_gasto_id") @db.SmallInt
  codigo           String  @unique @db.VarChar(30)
  nombre           String  @db.VarChar(100)
  activa           Boolean @default(true)

  gastos Gasto[]

  @@map("categoria_gasto")
  @@schema("public")
}

model Usuario {
  usuarioId       String   @id @default(dbgenerated("gen_random_uuid()")) @map("usuario_id") @db.Uuid
  estadoUsuarioId Int      @map("estado_usuario_id") @db.SmallInt
  nombreUsuario   String   @unique @map("nombre_usuario") @db.VarChar(60)
  passwordHash    String   @map("password_hash") @db.VarChar(255)
  nombres         String   @db.VarChar(120)
  apellidos       String   @db.VarChar(120)
  correo          String   @db.VarChar(180)
  telefono        String?  @db.VarChar(40)
  creadoEn        DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn   DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  estadoUsuario        EstadoUsuario                  @relation(fields: [estadoUsuarioId], references: [estadoUsuarioId])
  roles                UsuarioRol[]
  clientesCreados      Cliente[]                      @relation("ClienteCreadoPor")
  rutas                Ruta[]                         @relation("RutaResponsable")
  creditosCreados      Credito[]                      @relation("CreditoCreadoPor")
  cajasMenores         CajaMenor[]                    @relation("CajaMenorResponsable")
  movimientosCajaMenor CajaMenorMovimiento[]
  auditoriasCajaMenor  CajaMenorMovimientoAuditoria[] @relation("CajaMenorMovimientoAuditoriaUsuario")
  auditorias           Auditoria[]                    @relation("AuditoriaUsuario")
  gastosRegistrados    Gasto[]                        @relation("GastoRegistradoPor")
  pagosComoCobrador    Pago[]                         @relation("PagoCobrador")
  presupuestosPeriodo  PresupuestoPeriodo[]

  @@map("usuario")
  @@schema("public")
}

model UsuarioRol {
  usuarioId  String   @map("usuario_id") @db.Uuid
  rolId      Int      @map("rol_id") @db.SmallInt
  asignadoEn DateTime @default(now()) @map("asignado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [usuarioId], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId], references: [rolId])

  @@id([usuarioId, rolId])
  @@map("usuario_rol")
  @@schema("public")
}

model Cliente {
  clienteId          String   @id @default(dbgenerated("gen_random_uuid()")) @map("cliente_id") @db.Uuid
  estadoClienteId    Int      @map("estado_cliente_id") @db.SmallInt
  creadoPorUsuarioId String?  @map("creado_por_usuario_id") @db.Uuid
  nombreCompleto     String   @map("nombre_completo") @db.VarChar(180)
  nombreComercial    String?  @map("nombre_comercial") @db.VarChar(180)
  notas              String?
  creadoEn           DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn      DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  estadoCliente EstadoCliente      @relation(fields: [estadoClienteId], references: [estadoClienteId])
  creadoPor     Usuario?           @relation("ClienteCreadoPor", fields: [creadoPorUsuarioId], references: [usuarioId])
  documentos    ClienteDocumento[]
  contactos     ClienteContacto[]
  direcciones   ClienteDireccion[]
  rutas         RutaCliente[]
  creditos      Credito[]
  pagos         Pago[]

  @@index([nombreCompleto], map: "ix_cliente_nombre_completo")
  @@map("cliente")
  @@schema("public")
}

model ClienteDocumento {
  clienteDocumentoId String  @id @default(dbgenerated("gen_random_uuid()")) @map("cliente_documento_id") @db.Uuid
  clienteId          String  @map("cliente_id") @db.Uuid
  tipoDocumentoId    Int     @map("tipo_documento_id") @db.SmallInt
  numeroDocumento    String  @map("numero_documento") @db.VarChar(60)
  expedidoEn         String? @map("expedido_en") @db.VarChar(120)

  cliente       Cliente       @relation(fields: [clienteId], references: [clienteId], onDelete: Cascade)
  tipoDocumento TipoDocumento @relation(fields: [tipoDocumentoId], references: [tipoDocumentoId])

  @@unique([tipoDocumentoId, numeroDocumento])
  @@unique([clienteId, tipoDocumentoId, numeroDocumento])
  @@map("cliente_documento")
  @@schema("public")
}

model ClienteContacto {
  clienteContactoId String    @id @default(dbgenerated("gen_random_uuid()")) @map("cliente_contacto_id") @db.Uuid
  clienteId         String    @map("cliente_id") @db.Uuid
  tipoContactoId    Int       @map("tipo_contacto_id") @db.SmallInt
  valor             String    @db.VarChar(180)
  esPrincipal       Boolean   @default(false) @map("es_principal")
  verificadoEn      DateTime? @map("verificado_en") @db.Timestamptz(6)

  cliente      Cliente      @relation(fields: [clienteId], references: [clienteId], onDelete: Cascade)
  tipoContacto TipoContacto @relation(fields: [tipoContactoId], references: [tipoContactoId])

  @@unique([clienteId, tipoContactoId, valor])
  @@map("cliente_contacto")
  @@schema("public")
}

model ClienteDireccion {
  clienteDireccionId String   @id @default(dbgenerated("gen_random_uuid()")) @map("cliente_direccion_id") @db.Uuid
  clienteId          String   @map("cliente_id") @db.Uuid
  tipoDireccionId    Int      @map("tipo_direccion_id") @db.SmallInt
  direccion          String   @db.VarChar(220)
  barrio             String?  @db.VarChar(120)
  municipio          String   @db.VarChar(120)
  departamento       String   @db.VarChar(120)
  pais               String   @default("Colombia") @db.VarChar(80)
  referencia         String?
  latitud            Decimal? @db.Decimal(10, 7)
  longitud           Decimal? @db.Decimal(10, 7)
  esPrincipal        Boolean  @default(false) @map("es_principal")

  cliente       Cliente       @relation(fields: [clienteId], references: [clienteId], onDelete: Cascade)
  tipoDireccion TipoDireccion @relation(fields: [tipoDireccionId], references: [tipoDireccionId])

  @@unique([clienteId, tipoDireccionId, direccion])
  @@map("cliente_direccion")
  @@schema("public")
}

model Ruta {
  rutaId               String   @id @default(dbgenerated("gen_random_uuid()")) @map("ruta_id") @db.Uuid
  responsableUsuarioId String   @map("responsable_usuario_id") @db.Uuid
  estadoRutaId         Int      @map("estado_ruta_id") @db.SmallInt
  nombre               String   @db.VarChar(120)
  descripcion          String?
  esPrincipal          Boolean  @default(false) @map("es_principal")
  creadoEn             DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn        DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  responsable Usuario       @relation("RutaResponsable", fields: [responsableUsuarioId], references: [usuarioId])
  estadoRuta  EstadoRuta    @relation(fields: [estadoRutaId], references: [estadoRutaId])
  clientes    RutaCliente[]
  creditos    Credito[]
  pagos       Pago[]

  @@unique([responsableUsuarioId, nombre])
  @@map("ruta")
  @@schema("public")
}

model RutaCliente {
  rutaId      String   @map("ruta_id") @db.Uuid
  clienteId   String   @map("cliente_id") @db.Uuid
  ordenVisita Int      @map("orden_visita")
  activo      Boolean  @default(true)
  asignadoEn  DateTime @default(now()) @map("asignado_en") @db.Date

  ruta    Ruta    @relation(fields: [rutaId], references: [rutaId], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [clienteId], onDelete: Restrict)

  @@id([rutaId, clienteId])
  @@unique([rutaId, ordenVisita])
  @@map("ruta_cliente")
  @@schema("public")
}

model Credito {
  creditoId                  String    @id @default(dbgenerated("gen_random_uuid()")) @map("credito_id") @db.Uuid
  clienteId                  String    @map("cliente_id") @db.Uuid
  rutaId                     String    @map("ruta_id") @db.Uuid
  monedaCodigo               String    @map("moneda_codigo") @db.Char(3)
  frecuenciaPagoId           Int       @map("frecuencia_pago_id") @db.SmallInt
  estadoCreditoId            Int       @map("estado_credito_id") @db.SmallInt
  creadoPorUsuarioId         String?   @map("creado_por_usuario_id") @db.Uuid
  fechaInicio                DateTime  @map("fecha_inicio") @db.Date
  valorPrincipal             Decimal   @map("valor_principal") @db.Decimal(14, 2)
  porcentajeInteres          Decimal   @map("porcentaje_interes") @db.Decimal(7, 4)
  plazoDias                  Int       @map("plazo_dias")
  omitirDomingos             Boolean   @default(true) @map("omitir_domingos")
  observacion                String?
  refinanciadoEn             DateTime? @map("refinanciado_en") @db.Timestamptz(6)
  valorPrincipalAnterior     Decimal?  @map("valor_principal_anterior") @db.Decimal(14, 2)
  valorPrincipalRefinanciado Decimal?  @map("valor_principal_refinanciado") @db.Decimal(14, 2)
  creadoEn                   DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn              DateTime  @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  cliente        Cliente            @relation(fields: [clienteId], references: [clienteId], onDelete: Restrict)
  ruta           Ruta               @relation(fields: [rutaId], references: [rutaId], onDelete: Restrict)
  moneda         Moneda             @relation(fields: [monedaCodigo], references: [codigoMoneda])
  frecuenciaPago FrecuenciaPago     @relation(fields: [frecuenciaPagoId], references: [frecuenciaPagoId])
  estadoCredito  EstadoCredito      @relation(fields: [estadoCreditoId], references: [estadoCreditoId])
  creadoPor      Usuario?           @relation("CreditoCreadoPor", fields: [creadoPorUsuarioId], references: [usuarioId])
  planPago       CreditoPlanPago?
  desembolso     CreditoDesembolso?

  @@index([clienteId], map: "ix_credito_cliente")
  @@index([rutaId, estadoCreditoId], map: "ix_credito_ruta_estado")
  @@map("credito")
  @@schema("public")
}

model CreditoPlanPago {
  creditoPlanPagoId String   @id @default(dbgenerated("gen_random_uuid()")) @map("credito_plan_pago_id") @db.Uuid
  creditoId         String   @unique @map("credito_id") @db.Uuid
  numeroCuotas      Int      @map("numero_cuotas")
  valorCuota        Decimal  @map("valor_cuota") @db.Decimal(14, 2)
  valorTotal        Decimal  @map("valor_total") @db.Decimal(14, 2)
  fechaMaxima       DateTime @map("fecha_maxima") @db.Date
  domingosOmitidos  Int      @default(0) @map("domingos_omitidos")
  generadoEn        DateTime @default(now()) @map("generado_en") @db.Timestamptz(6)

  credito Credito        @relation(fields: [creditoId], references: [creditoId], onDelete: Cascade)
  cuotas  CreditoCuota[]

  @@map("credito_plan_pago")
  @@schema("public")
}

model CreditoCuota {
  creditoCuotaId    String   @id @default(dbgenerated("gen_random_uuid()")) @map("credito_cuota_id") @db.Uuid
  creditoPlanPagoId String   @map("credito_plan_pago_id") @db.Uuid
  estadoCuotaId     Int      @map("estado_cuota_id") @db.SmallInt
  numeroCuota       Int      @map("numero_cuota")
  fechaVencimiento  DateTime @map("fecha_vencimiento") @db.Date
  valorCapital      Decimal  @default(0) @map("valor_capital") @db.Decimal(14, 2)
  valorInteres      Decimal  @default(0) @map("valor_interes") @db.Decimal(14, 2)
  valorTotal        Decimal  @default(dbgenerated()) @map("valor_total") @db.Decimal(14, 2)

  planPago     CreditoPlanPago  @relation(fields: [creditoPlanPagoId], references: [creditoPlanPagoId], onDelete: Cascade)
  estadoCuota  EstadoCuota      @relation(fields: [estadoCuotaId], references: [estadoCuotaId])
  aplicaciones PagoAplicacion[]

  @@unique([creditoPlanPagoId, numeroCuota])
  @@index([fechaVencimiento, estadoCuotaId], map: "ix_credito_cuota_vencimiento_estado")
  @@map("credito_cuota")
  @@schema("public")
}

model CajaMenor {
  cajaMenorId          String    @id @default(dbgenerated("gen_random_uuid()")) @map("caja_menor_id") @db.Uuid
  responsableUsuarioId String    @map("responsable_usuario_id") @db.Uuid
  monedaCodigo         String    @map("moneda_codigo") @db.Char(3)
  nombre               String    @db.VarChar(120)
  activa               Boolean   @default(true)
  fechaApertura        DateTime  @default(now()) @map("fecha_apertura") @db.Timestamptz(6)
  fechaCierre          DateTime? @map("fecha_cierre") @db.Timestamptz(6)
  creadaEn             DateTime  @default(now()) @map("creada_en") @db.Timestamptz(6)
  actualizadoEn        DateTime  @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  responsable Usuario                        @relation("CajaMenorResponsable", fields: [responsableUsuarioId], references: [usuarioId])
  moneda      Moneda                         @relation(fields: [monedaCodigo], references: [codigoMoneda])
  movimientos CajaMenorMovimiento[]
  auditorias  CajaMenorMovimientoAuditoria[]
  gastos      Gasto[]

  @@unique([responsableUsuarioId, nombre])
  @@map("caja_menor")
  @@schema("public")
}

model CajaMenorMovimiento {
  cajaMenorMovimientoId String   @id @default(dbgenerated("gen_random_uuid()")) @map("caja_menor_movimiento_id") @db.Uuid
  cajaMenorId           String   @map("caja_menor_id") @db.Uuid
  tipoMovimientoCajaId  Int      @map("tipo_movimiento_caja_id") @db.SmallInt
  usuarioId             String?  @map("usuario_id") @db.Uuid
  fechaMovimiento       DateTime @map("fecha_movimiento") @db.Date
  monto                 Decimal  @db.Decimal(14, 2)
  motivo                String
  referenciaTabla       String?  @map("referencia_tabla") @db.VarChar(80)
  referenciaId          String?  @map("referencia_id") @db.Uuid
  creadoEn              DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  cajaMenor          CajaMenor          @relation(fields: [cajaMenorId], references: [cajaMenorId])
  tipoMovimientoCaja TipoMovimientoCaja @relation(fields: [tipoMovimientoCajaId], references: [tipoMovimientoCajaId])
  usuario            Usuario?           @relation(fields: [usuarioId], references: [usuarioId])
  desembolsoCredito  CreditoDesembolso?

  @@index([cajaMenorId, fechaMovimiento], map: "ix_caja_menor_movimiento_fecha")
  @@map("caja_menor_movimiento")
  @@schema("public")
}

model CajaMenorMovimientoAuditoria {
  cajaMenorMovimientoAuditoriaId String   @id @default(dbgenerated("gen_random_uuid()")) @map("caja_menor_movimiento_auditoria_id") @db.Uuid
  cajaMenorId                    String   @map("caja_menor_id") @db.Uuid
  cajaMenorMovimientoId          String?  @map("caja_menor_movimiento_id") @db.Uuid
  usuarioId                      String?  @map("usuario_id") @db.Uuid
  accion                         String   @db.VarChar(20)
  detalle                        String
  creadoEn                       DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  cajaMenor CajaMenor @relation(fields: [cajaMenorId], references: [cajaMenorId])
  usuario   Usuario?  @relation("CajaMenorMovimientoAuditoriaUsuario", fields: [usuarioId], references: [usuarioId])

  @@index([cajaMenorId, creadoEn], map: "ix_caja_menor_movimiento_auditoria_fecha")
  @@map("caja_menor_movimiento_auditoria")
  @@schema("public")
}

model Auditoria {
  auditoriaId       String   @id @default(dbgenerated("gen_random_uuid()")) @map("auditoria_id") @db.Uuid
  usuarioId         String?  @map("usuario_id") @db.Uuid
  tabla             String   @db.VarChar(80)
  registroId        String?  @map("registro_id") @db.VarChar(120)
  accion            String   @db.VarChar(40)
  descripcion       String
  valoresAnteriores Json?    @map("valores_anteriores")
  valoresNuevos     Json?    @map("valores_nuevos")
  metadata          Json?
  creadoEn          DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario? @relation("AuditoriaUsuario", fields: [usuarioId], references: [usuarioId])

  @@index([tabla, registroId, creadoEn], map: "ix_auditoria_registro_fecha")
  @@index([usuarioId, creadoEn], map: "ix_auditoria_usuario_fecha")
  @@map("auditoria")
  @@schema("public")
}

model CreditoDesembolso {
  creditoDesembolsoId   String   @id @default(dbgenerated("gen_random_uuid()")) @map("credito_desembolso_id") @db.Uuid
  creditoId             String   @unique @map("credito_id") @db.Uuid
  cajaMenorMovimientoId String?  @unique @map("caja_menor_movimiento_id") @db.Uuid
  fechaDesembolso       DateTime @map("fecha_desembolso") @db.Date
  monto                 Decimal  @db.Decimal(14, 2)
  creadoEn              DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  credito             Credito              @relation(fields: [creditoId], references: [creditoId], onDelete: Restrict)
  cajaMenorMovimiento CajaMenorMovimiento? @relation(fields: [cajaMenorMovimientoId], references: [cajaMenorMovimientoId])

  @@map("credito_desembolso")
  @@schema("public")
}

model Gasto {
  gastoId                String   @id @default(dbgenerated("gen_random_uuid()")) @map("gasto_id") @db.Uuid
  cajaMenorId            String?  @map("caja_menor_id") @db.Uuid
  categoriaGastoId       Int      @map("categoria_gasto_id") @db.SmallInt
  monedaCodigo           String   @map("moneda_codigo") @db.Char(3)
  registradoPorUsuarioId String?  @map("registrado_por_usuario_id") @db.Uuid
  fechaGasto             DateTime @map("fecha_gasto") @db.Date
  monto                  Decimal  @db.Decimal(14, 2)
  concepto               String
  creadoEn               DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn          DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  cajaMenor            CajaMenor?     @relation(fields: [cajaMenorId], references: [cajaMenorId])
  categoriaGasto       CategoriaGasto @relation(fields: [categoriaGastoId], references: [categoriaGastoId])
  moneda               Moneda         @relation(fields: [monedaCodigo], references: [codigoMoneda])
  registradoPorUsuario Usuario?       @relation("GastoRegistradoPor", fields: [registradoPorUsuarioId], references: [usuarioId])

  @@index([fechaGasto], map: "ix_gasto_fecha")
  @@map("gasto")
  @@schema("public")
}

model Pago {
  pagoId            String   @id @default(dbgenerated("gen_random_uuid()")) @map("pago_id") @db.Uuid
  clienteId         String   @map("cliente_id") @db.Uuid
  rutaId            String   @map("ruta_id") @db.Uuid
  cobradorUsuarioId String?  @map("cobrador_usuario_id") @db.Uuid
  medioPagoId       Int      @map("medio_pago_id") @db.SmallInt
  monedaCodigo      String   @map("moneda_codigo") @db.Char(3)
  fechaPago         DateTime @default(now()) @map("fecha_pago") @db.Timestamptz(6)
  totalPagado       Decimal  @map("total_pagado") @db.Decimal(14, 2)
  referenciaExterna String?  @map("referencia_externa") @db.VarChar(120)
  observacion       String?
  creadoEn          DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  cliente      Cliente          @relation(fields: [clienteId], references: [clienteId], onDelete: Restrict)
  ruta         Ruta             @relation(fields: [rutaId], references: [rutaId], onDelete: Restrict)
  cobrador     Usuario?         @relation("PagoCobrador", fields: [cobradorUsuarioId], references: [usuarioId])
  medioPago    MedioPago        @relation(fields: [medioPagoId], references: [medioPagoId])
  moneda       Moneda           @relation(fields: [monedaCodigo], references: [codigoMoneda])
  aplicaciones PagoAplicacion[]

  @@index([rutaId, fechaPago], map: "ix_pago_fecha_ruta")
  @@map("pago")
  @@schema("public")
}

model PagoAplicacion {
  pagoAplicacionId String  @id @default(dbgenerated("gen_random_uuid()")) @map("pago_aplicacion_id") @db.Uuid
  pagoId           String  @map("pago_id") @db.Uuid
  creditoCuotaId   String  @map("credito_cuota_id") @db.Uuid
  montoCapital     Decimal @default(0) @map("monto_capital") @db.Decimal(14, 2)
  montoInteres     Decimal @default(0) @map("monto_interes") @db.Decimal(14, 2)
  montoMora        Decimal @default(0) @map("monto_mora") @db.Decimal(14, 2)
  montoDescuento   Decimal @default(0) @map("monto_descuento") @db.Decimal(14, 2)

  pago         Pago         @relation(fields: [pagoId], references: [pagoId], onDelete: Cascade)
  creditoCuota CreditoCuota @relation(fields: [creditoCuotaId], references: [creditoCuotaId], onDelete: Restrict)

  @@unique([pagoId, creditoCuotaId])
  @@map("pago_aplicacion")
  @@schema("public")
}

model PresupuestoPeriodo {
  presupuestoPeriodoId String   @id @default(dbgenerated("gen_random_uuid()")) @map("presupuesto_periodo_id") @db.Uuid
  usuarioId            String?  @map("usuario_id") @db.Uuid
  monedaCodigo         String   @map("moneda_codigo") @db.Char(3)
  fechaInicio          DateTime @map("fecha_inicio") @db.Date
  fechaFin             DateTime @map("fecha_fin") @db.Date
  nombre               String   @db.VarChar(120)
  creadoEn             DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario? @relation(fields: [usuarioId], references: [usuarioId])
  moneda  Moneda   @relation(fields: [monedaCodigo], references: [codigoMoneda])

  @@unique([usuarioId, monedaCodigo, fechaInicio, fechaFin])
  @@map("presupuesto_periodo")
  @@schema("public")
}

model TblPersona {
  idPer        BigInt   @id @default(autoincrement()) @map("id_per")
  primerNombre String   @map("per_primer_nombre")
  apellido     String   @map("per_apellido")
  documento    String   @unique @map("per_documento")
  direccion    String?  @map("per_direccion")
  latitud      Decimal? @map("per_latitud") @db.Decimal(10, 7)
  longitud     Decimal? @map("per_longitud") @db.Decimal(10, 7)
  celular      String?  @map("per_num_celular")
  creacion     DateTime @default(now()) @map("per_creacion") @db.Timestamptz(6)

  usuario  TblUsuario?
  clientes TblCliente[] @relation("TblClientePersona")

  @@map("tbl_personas")
  @@schema("public")
}

model TblUsuario {
  idUsu     BigInt   @id @default(autoincrement()) @map("id_usu")
  usuario   String   @unique @map("usu_usuario")
  password  String   @map("usu_password")
  creacion  DateTime @default(now()) @map("usu_creacion") @db.Timestamptz(6)
  email     String   @map("usu_email")
  activo    Boolean  @default(true) @map("usu_activo")
  personaId BigInt   @unique @map("persona_id")

  persona         TblPersona               @relation(fields: [personaId], references: [idPer])
  organizaciones  TblUsuarioOrganizacion[]
  rutas           TblRuta[]
  gastos          TblGasto[]
  sesionesCajas   TblSesionCaja[]
  movimientosCaja TblMovimientoCaja[]
  creditos        TblCredito[]

  @@map("tbl_usuarios")
  @@schema("public")
}

model TblRol {
  idRol    BigInt   @id @default(autoincrement()) @map("id_rol")
  tipo     String   @unique @map("rol_tip")
  nivel    BigInt   @map("rol_nivel")
  creacion DateTime @default(now()) @map("rol_creacion") @db.Timestamptz(6)

  recursos       TblRolRecurso[]
  organizaciones TblUsuarioOrganizacion[]

  @@map("tbl_roles")
  @@schema("public")
}

model TblRecurso {
  idRec     BigInt  @id @default(autoincrement()) @map("id_rec")
  nombre    String  @map("nom")
  icono     String? @map("rec_icono")
  orden     BigInt  @default(0) @map("rec_orden")
  interface String  @default("WEB") @map("rec_interface")

  roles TblRolRecurso[]

  @@map("tbl_recursos")
  @@schema("public")
}

model TblRolRecurso {
  idRor BigInt @id @default(autoincrement()) @map("id_ror")
  recId BigInt @map("rec_id")
  rolId BigInt @map("rol_id")

  recurso TblRecurso @relation(fields: [recId], references: [idRec])
  rol     TblRol     @relation(fields: [rolId], references: [idRol])

  @@map("tbl_roles_recursos")
  @@schema("public")
}

model TblOrganizacion {
  idOrg    BigInt   @id @default(autoincrement()) @map("id_org")
  nombre   String   @unique @map("org_nombre")
  telefono String?  @map("org_telefono")
  email    String?  @map("org_email")
  activo   Boolean  @default(true) @map("org_activo")
  creacion DateTime @default(now()) @map("org_creacion") @db.Timestamptz(6)

  usuarios         TblUsuarioOrganizacion[]
  clientes         TblCliente[]
  rutas            TblRuta[]
  productosCredito TblProductoCredito[]
  cajas            TblCaja[]
  mediosPago       TblMedioPago[]
  movimientosCaja  TblMovimientoCaja[]

  @@map("tbl_organizaciones")
  @@schema("public")
}

model TblUsuarioOrganizacion {
  idUrg  BigInt  @id @default(autoincrement()) @map("id_urg")
  activo Boolean @default(true) @map("urg_activo")
  rolId  BigInt  @map("rol_id")
  usuId  BigInt  @map("usu_id")
  orgId  BigInt  @map("org_id")

  rol          TblRol          @relation(fields: [rolId], references: [idRol])
  usuario      TblUsuario      @relation(fields: [usuId], references: [idUsu])
  organizacion TblOrganizacion @relation(fields: [orgId], references: [idOrg])

  @@map("tbl_usuarios_organizaciones")
  @@schema("public")
}

model TblCliente {
  idCli      BigInt   @id @default(autoincrement()) @map("id_cli")
  referencia String?  @map("cli_referencia")
  activo     Boolean  @default(true) @map("cli_activo")
  creacion   DateTime @default(now()) @map("cli_creacion") @db.Timestamptz(6)
  orgId      BigInt   @map("org_id")
  personaId  BigInt   @map("cli_persona")

  organizacion TblOrganizacion  @relation(fields: [orgId], references: [idOrg])
  persona      TblPersona       @relation("TblClientePersona", fields: [personaId], references: [idPer])
  rutas        TblRutaCliente[]
  creditos     TblCredito[]

  @@map("tbl_clientes")
  @@schema("public")
}

model TblRuta {
  idRut       BigInt   @id @default(autoincrement()) @map("id_rut")
  nombre      String   @map("rut_nombre")
  descripcion String?  @map("rut_descripcion")
  activa      Boolean  @default(true) @map("rut_activa")
  creacion    DateTime @default(now()) @map("rut_creacion") @db.Timestamptz(6)
  usuId       BigInt   @map("usu_id")
  orgId       BigInt   @map("org_id")

  usuario      TblUsuario       @relation(fields: [usuId], references: [idUsu])
  organizacion TblOrganizacion  @relation(fields: [orgId], references: [idOrg])
  clientes     TblRutaCliente[]

  @@map("tbl_rutas")
  @@schema("public")
}

model TblRutaCliente {
  idRcl    BigInt   @id @default(autoincrement()) @map("id_rcl")
  activo   Boolean  @default(true) @map("rcl_activo")
  creacion DateTime @default(now()) @map("rcl_creacion") @db.Timestamptz(6)
  rutId    BigInt   @map("rut_id")
  cliId    BigInt   @map("cli_id")

  ruta    TblRuta    @relation(fields: [rutId], references: [idRut])
  cliente TblCliente @relation(fields: [cliId], references: [idCli])

  @@map("tbl_rutas_clientes")
  @@schema("public")
}

model TblProductoCredito {
  idPcr       BigInt  @id @default(autoincrement()) @map("id_pcr")
  nombre      String  @map("pcr_nombre")
  frecuencia  String  @map("pcr_frecuencia")
  tasaInteres Decimal @map("pcr_tasa_interes")
  orgId       BigInt  @map("org_id")

  organizacion TblOrganizacion @relation(fields: [orgId], references: [idOrg])
  creditos     TblCredito[]

  @@map("tbl_productos_creditos")
  @@schema("public")
}

model TblCategoriaGasto {
  idCga       BigInt  @id @default(autoincrement()) @map("id_cga")
  nombre      String  @unique @map("cga_nombre")
  descripcion String? @map("cga_descripcion")

  gastos TblGasto[]

  @@map("tbl_categorias_gastos")
  @@schema("public")
}

model TblCaja {
  idCaj    BigInt   @id @default(autoincrement()) @map("id_caj")
  nombre   String   @map("caj_nombre")
  tipo     String   @default("MENOR") @map("caj_tipo")
  activa   Boolean  @default(true) @map("caj_activa")
  creacion DateTime @default(now()) @map("caj_creacion") @db.Timestamptz(6)
  orgId    BigInt   @map("org_id")
  gasId    BigInt?  @map("gas_id")

  organizacion TblOrganizacion @relation(fields: [orgId], references: [idOrg])
  gasto        TblGasto?       @relation("TblCajaGasto", fields: [gasId], references: [idGas])
  gastos       TblGasto[]      @relation("TblGastoCaja")
  sesiones     TblSesionCaja[]

  @@map("tbl_cajas")
  @@schema("public")
}

model TblGasto {
  idGas BigInt   @id @default(autoincrement()) @map("id_gas")
  fecha DateTime @default(now()) @map("gas_fecha") @db.Timestamptz(6)
  monto Decimal  @map("gas_monto")
  cajId BigInt   @map("caj_id")
  usuId BigInt   @map("usu_id")
  cgaId BigInt   @map("cga_id")

  caja      TblCaja           @relation("TblGastoCaja", fields: [cajId], references: [idCaj])
  usuario   TblUsuario        @relation(fields: [usuId], references: [idUsu])
  categoria TblCategoriaGasto @relation(fields: [cgaId], references: [idCga])
  cajas     TblCaja[]         @relation("TblCajaGasto")

  @@map("tbl_gastos")
  @@schema("public")
}

model TblSesionCaja {
  idSca         BigInt    @id @default(autoincrement()) @map("id_sca")
  fechaApertura DateTime  @default(now()) @map("sca_fecha_apertura") @db.Timestamptz(6)
  fechaCierre   DateTime? @map("sca_fecha_cierre") @db.Timestamptz(6)
  montoInicial  Decimal   @default(0) @map("sca_monto_inicial")
  totalCobrado  Decimal   @default(0) @map("sca_total_cobrado")
  totalGasto    Decimal   @default(0) @map("sca_total_gasto")
  estado        String    @default("ABIERTA") @map("sca_estado")
  cajId         BigInt    @map("caj_id")
  usuId         BigInt    @map("usu_id")

  caja            TblCaja             @relation(fields: [cajId], references: [idCaj])
  usuario         TblUsuario          @relation(fields: [usuId], references: [idUsu])
  movimientosCaja TblMovimientoCaja[]

  @@map("tbl_sesiones_cajas")
  @@schema("public")
}

model TblMovimientoCaja {
  idMca          BigInt   @id @default(autoincrement()) @map("id_mca")
  tipo           String   @map("mca_tipo")
  monto          Decimal  @map("mca_monto")
  referenciaId   BigInt?  @map("mca_referencia_id")
  referenciaTipo String?  @map("mca_referencia_tipo")
  creacion       DateTime @default(now()) @map("mca_creacion") @db.Timestamptz(6)
  orgId          BigInt   @map("org_id")
  usuId          BigInt   @map("usu_id")
  scaId          BigInt?  @map("sca_id")

  organizacion TblOrganizacion @relation(fields: [orgId], references: [idOrg])
  usuario      TblUsuario      @relation(fields: [usuId], references: [idUsu])
  sesion       TblSesionCaja?  @relation(fields: [scaId], references: [idSca])

  @@map("tbl_movimientos_cajas")
  @@schema("public")
}

model TblCredito {
  idCre        BigInt   @id @default(autoincrement()) @map("id_cre")
  total        Decimal  @map("cre_total")
  estado       String   @default("ACTIVO") @map("cre_estado")
  tasaInteres  Decimal  @map("cre_tasa_interes")
  interesTotal Decimal  @map("cre_interes_total")
  totalPagar   Decimal  @map("cre_total_pagar")
  fechaInicio  DateTime @map("cre_fecha_inicio") @db.Date
  fechaFin     DateTime @map("cre_fecha_fin") @db.Date
  usuId        BigInt   @map("usu_id")
  pcrId        BigInt   @map("pcr_id")
  cliId        BigInt   @map("cli_id")

  usuario  TblUsuario         @relation(fields: [usuId], references: [idUsu])
  producto TblProductoCredito @relation(fields: [pcrId], references: [idPcr])
  cliente  TblCliente         @relation(fields: [cliId], references: [idCli])
  cuotas   TblCuota[]
  pagos    TblPago[]

  @@map("tbl_creditos")
  @@schema("public")
}

model TblCuota {
  idCuo            BigInt   @id @default(autoincrement()) @map("id_cuo")
  numero           BigInt   @map("cuo_numero")
  valor            Decimal  @map("cuo_valor")
  totalPagado      Decimal  @default(0) @map("cuo_total_pagado")
  estado           String   @default("PENDIENTE") @map("cuo_estado")
  fechaVencimiento DateTime @map("cuo_fecha_vencimiento") @db.Date
  creId            BigInt   @map("cre_id")

  credito TblCredito     @relation(fields: [creId], references: [idCre])
  pagos   TblCuotaPago[]

  @@map("tbl_cuotas")
  @@schema("public")
}

model TblMedioPago {
  idMed            BigInt   @id @default(autoincrement()) @map("id_med")
  nombre           String   @map("med_nombre")
  tipo             String   @map("med_tipo")
  proveedor        String?  @map("med_proveedor")
  referenciaCuenta String?  @map("med_referencia_cuenta")
  titular          String?  @map("med_titular")
  activo           Boolean  @default(true) @map("med_activo")
  creacion         DateTime @default(now()) @map("med_creacion") @db.Timestamptz(6)
  actualizacion    DateTime @default(now()) @map("med_actualizacion") @db.Timestamptz(6)
  orgId            BigInt   @map("org_id")

  organizacion TblOrganizacion @relation(fields: [orgId], references: [idOrg])
  pagos        TblPago[]

  @@map("tbl_medios_pagos")
  @@schema("public")
}

model TblPago {
  idPag            BigInt   @id @default(autoincrement()) @map("id_pag")
  monto            Decimal  @map("pag_monto")
  fecha            DateTime @default(now()) @map("pag_fecha") @db.Timestamptz(6)
  referencia       String?  @map("pag_referencia")
  idempotencyLlave String   @unique @default(dbgenerated("gen_random_uuid()")) @map("pag_idempotency_llave") @db.Uuid
  estado           String   @default("REGISTRADO") @map("pag_estado")
  medId            BigInt   @map("med_id")
  creId            BigInt   @map("cre_id")

  medioPago TblMedioPago   @relation(fields: [medId], references: [idMed])
  credito   TblCredito     @relation(fields: [creId], references: [idCre])
  cuotas    TblCuotaPago[]

  @@map("tbl_pagos")
  @@schema("public")
}

model TblCuotaPago {
  idCpa   BigInt  @id @default(autoincrement()) @map("id_cpa")
  numero  BigInt? @map("cpa_numero")
  capital Decimal @default(0) @map("cpa_capital")
  interes Decimal @default(0) @map("cpa_interes")
  total   Decimal @default(dbgenerated()) @map("cpa_total")
  cuoId   BigInt  @map("cuo_id")
  pagosId BigInt  @map("pagos_id")

  cuota TblCuota @relation(fields: [cuoId], references: [idCuo])
  pago  TblPago  @relation(fields: [pagosId], references: [idPag])

  @@map("tbl_cuotas_pagos")
  @@schema("public")
}
