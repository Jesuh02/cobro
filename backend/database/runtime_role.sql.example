-- Run once as the Supabase database owner, after replacing the password.
-- Never commit the real password. Use at least 32 random characters.
CREATE ROLE cobro_runtime NOLOGIN
  NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOREPLICATION;

CREATE ROLE cobro_api LOGIN
  PASSWORD '<REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_PASSWORD>'
  NOSUPERUSER NOCREATEDB NOCREATEROLE INHERIT NOREPLICATION;

GRANT cobro_runtime TO cobro_api;
GRANT USAGE ON SCHEMA public TO cobro_runtime;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public
  TO cobro_runtime;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO cobro_runtime;
GRANT EXECUTE ON ALL FUNCTIONS IN SCHEMA public TO cobro_runtime;

-- RLS stays deny-by-default for Supabase's API roles. This policy grants the
-- dedicated backend role access; authorization remains enforced by NestJS.
DO $runtime_policies$
DECLARE
  table_record record;
BEGIN
  FOR table_record IN
    SELECT schemaname, tablename
    FROM pg_catalog.pg_tables
    WHERE schemaname = 'public'
      AND tablename <> '_prisma_migrations'
  LOOP
    EXECUTE format(
      'DROP POLICY IF EXISTS cobro_backend_access ON %I.%I',
      table_record.schemaname,
      table_record.tablename
    );
    EXECUTE format(
      'CREATE POLICY cobro_backend_access ON %I.%I TO cobro_runtime USING (true) WITH CHECK (true)',
      table_record.schemaname,
      table_record.tablename
    );
  END LOOP;
END
$runtime_policies$;

ALTER DEFAULT PRIVILEGES IN SCHEMA public
  GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO cobro_runtime;
ALTER DEFAULT PRIVILEGES IN SCHEMA public
  GRANT USAGE, SELECT ON SEQUENCES TO cobro_runtime;
ALTER DEFAULT PRIVILEGES IN SCHEMA public
  GRANT EXECUTE ON FUNCTIONS TO cobro_runtime;

ALTER ROLE cobro_api SET search_path = public;
ALTER ROLE cobro_api SET statement_timeout = '60s';
ALTER ROLE cobro_api SET idle_in_transaction_session_timeout = '30s';

-- After verifying DATABASE_URL with cobro_api, remove this file from any
-- operational copy that contains a real password and rotate that password if
-- it was ever exposed.
