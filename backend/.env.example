NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGIN="http://localhost:8080"
TRUST_PROXY_HOPS=0
ENFORCE_HTTPS=false
AUTH_TOKEN_SECRET="replace-with-a-cryptographically-random-secret-of-at-least-64-characters"
AUTH_TOKEN_TTL_SECONDS=3600
ADMIN_USERNAME=admin
ADMIN_PASSWORD="replace-with-a-long-unique-administrator-password"
ADMIN_EMAIL="admin@cobro.local"
ADMIN_FULL_NAME="Administrador Cobro"
# Supabase: usa el rol dedicado creado con database/runtime_role.sql.example.
# CockroachDB Cloud: usa un usuario SQL dedicado, por ejemplo cobrod_app.
# En produccion sslmode=require (o verify-full) es obligatorio.
DATABASE_URL="postgresql://cobro_api:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?schema=public&sslmode=require"
# DATABASE_URL="postgresql://cobrod_app:<DB_PASSWORD>@<CLUSTER>.cockroachlabs.cloud:26257/cobrod?sslmode=verify-full"

# Desarrollo usa el demo público si queda vacío. En producción es obligatorio
# configurar una instancia OSRM controlada o autohospedada.
OSRM_BASE_URL=""
OSRM_TIMEOUT_MS=9000

# Notificaciones transaccionales
NOTIFICATIONS_ENABLED=false
NOTIFICATION_BRAND_NAME="Cobro"
NOTIFICATION_REPLY_TO=""
NOTIFICATION_TIME_ZONE="America/Bogota"

# Correo principal: Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@example.com"

# Respaldo de correo: Brevo SMTP
BREVO_FROM_EMAIL="noreply@example.com"
BREVO_SMTP_HOST="smtp-relay.sendinblue.com"
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=""
BREVO_SMTP_PASSWORD=""

# Exportaciones Excel en Cloudflare R2
R2_ACCESS_KEY_ID=""
R2_ACCOUNT_ID=""
R2_BUCKET_NAME=""
R2_SECRET_ACCESS_KEY=""
R2_SIGNED_URL_TTL_SECONDS=300

# Proveedor de WhatsApp: "openwa" (Open Source autónomo / Docker) o "ycloud" (API oficial Meta)
WHATSAPP_PROVIDER="openwa"
WHATSAPP_DEFAULT_COUNTRY_CODE="57"

# WhatsApp: Open-WA (Open Source)
OPENWA_ENABLED=true
OPENWA_BASE_URL="http://127.0.0.1:8080"
OPENWA_API_KEY="cobrod-secure-openwa-key"

# WhatsApp: YCloud (Alternativa comercial oficial)
YCLOUD_ENABLED=false
YCLOUD_API_KEY=""
YCLOUD_BASE_URL="https://api.ycloud.com/v2"
YCLOUD_INSTANCE_ID=""
YCLOUD_WHATSAPP_NUMBER=""
YCLOUD_WEBHOOK_ENDPOINT_ID=""
YCLOUD_WEBHOOK_SECRET=""
YCLOUD_WEBHOOK_TOLERANCE_SECONDS=300

# Recomendado: nombres de plantillas Utility aprobadas en Meta/YCloud.
YCLOUD_TEMPLATE_LANGUAGE="es_CO"
YCLOUD_TEMPLATE_CREDIT_APPROVED=""
YCLOUD_TEMPLATE_PAYMENT_RECEIVED=""
YCLOUD_TEMPLATE_CREDIT_COMPLETED=""
YCLOUD_TEMPLATE_COLLECTOR_OVERDUE=""

# Alternativa solo si Direct Send esta habilitado para la cuenta YCloud.
YCLOUD_USE_DIRECT_SEND=false
