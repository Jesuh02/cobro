generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

model TblPersona {
  idPer        String       @id @default(dbgenerated("gen_random_uuid()")) @map("id_per") @db.Uuid
  primerNombre String       @map("per_primer_nombre")
  apellido     String       @map("per_apellido")
  documento    String       @unique @map("per_documento")
  direccion    String?      @map("per_direccion")
  latitud      Decimal?     @map("per_latitud") @db.Decimal(10, 7)
  longitud     Decimal?     @map("per_longitud") @db.Decimal(10, 7)
  celular      String?      @map("per_num_celular")
  email        String?      @map("per_email")
  creacion     DateTime     @default(now()) @map("per_creacion") @db.Timestamptz(6)
  clientes     TblCliente[] @relation("TblClientePersona")
  usuario      TblUsuario?

  @@index([documento], map: "ix_tbl_personas_documento")
  @@map("tbl_personas")
  @@schema("public")
}

model TblUsuario {
  idUsu           String                   @id @default(dbgenerated("gen_random_uuid()")) @map("id_usu") @db.Uuid
  usuario         String                   @unique @map("usu_usuario")
  password        String                   @map("usu_password")
  creacion        DateTime                 @default(now()) @map("usu_creacion") @db.Timestamptz(6)
  activo          Boolean                  @default(true) @map("usu_activo")
  personaId       String                   @unique @map("persona_id") @db.Uuid
  creditos        TblCredito[]
  gastos          TblGasto[]
  movimientosCaja TblMovimientoCaja[]
  rutas           TblRuta[]
  sesionesCajas   TblSesionCaja[]
  persona         TblPersona               @relation(fields: [personaId], references: [idPer])
  organizaciones  TblUsuarioOrganizacion[]

  @@map("tbl_usuarios")
  @@schema("public")
}

model TblRol {
  idRol          String                   @id @default(dbgenerated("gen_random_uuid()")) @map("id_rol") @db.Uuid
  tipo           String                   @unique @map("rol_tip")
  nivel          BigInt                   @map("rol_nivel")
  creacion       DateTime                 @default(now()) @map("rol_creacion") @db.Timestamptz(6)
  recursos       TblRolRecurso[]
  organizaciones TblUsuarioOrganizacion[]

  @@map("tbl_roles")
  @@schema("public")
}

model TblRecurso {
  idRec     String          @id @default(dbgenerated("gen_random_uuid()")) @map("id_rec") @db.Uuid
  nombre    String          @map("nom")
  icono     String?         @map("rec_icono")
  orden     BigInt          @default(0) @map("rec_orden")
  interface String          @default("WEB") @map("rec_interface")
  roles     TblRolRecurso[]

  @@unique([interface, nombre], map: "ux_tbl_recursos_interface_nombre")
  @@map("tbl_recursos")
  @@schema("public")
}

model TblRolRecurso {
  idRor   String     @id @default(dbgenerated("gen_random_uuid()")) @map("id_ror") @db.Uuid
  recId   String     @map("rec_id") @db.Uuid
  rolId   String     @map("rol_id") @db.Uuid
  recurso TblRecurso @relation(fields: [recId], references: [idRec])
  rol     TblRol     @relation(fields: [rolId], references: [idRol])

  @@unique([recId, rolId], map: "ux_tbl_roles_recursos")
  @@map("tbl_roles_recursos")
  @@schema("public")
}

model TblOrganizacion {
  idOrg                   String                    @id @default(dbgenerated("gen_random_uuid()")) @map("id_org") @db.Uuid
  nombre                  String                    @unique @map("org_nombre")
  telefono                String?                   @map("org_telefono")
  email                   String?                   @map("org_email")
  activo                  Boolean                   @default(true) @map("org_activo")
  montoPlan               Decimal                   @default(0) @map("org_monto_plan")
  monedaPlan              String                    @default("COP") @map("org_moneda_plan") @db.Char(3)
  accesoHasta             DateTime?                 @map("org_acceso_hasta") @db.Date
  suspendidaEn            DateTime?                 @map("org_suspendida_en") @db.Timestamptz(6)
  motivoSuspension        String?                   @map("org_motivo_suspension")
  esSistema               Boolean                   @default(false) @map("org_es_sistema")
  creacion                DateTime                  @default(now()) @map("org_creacion") @db.Timestamptz(6)
  cajas                   TblCaja[]
  clientes                TblCliente[]
  movimientosCaja         TblMovimientoCaja[]
  tbl_notificaciones      tbl_notificaciones[]
  rutas                   TblRuta[]
  usuarios                TblUsuarioOrganizacion[]
  tbl_wompi_transacciones tbl_wompi_transacciones[]

  @@index([activo, accesoHasta], map: "ix_tbl_organizaciones_acceso")
  @@map("tbl_organizaciones")
  @@schema("public")
}

model TblUsuarioOrganizacion {
  idUrg        String          @id @default(dbgenerated("gen_random_uuid()")) @map("id_urg") @db.Uuid
  activo       Boolean         @default(true) @map("urg_activo")
  rolId        String          @map("rol_id") @db.Uuid
  usuId        String          @map("usu_id") @db.Uuid
  orgId        String          @map("org_id") @db.Uuid
  organizacion TblOrganizacion @relation(fields: [orgId], references: [idOrg])
  rol          TblRol          @relation(fields: [rolId], references: [idRol])
  usuario      TblUsuario      @relation(fields: [usuId], references: [idUsu])

  @@unique([usuId, orgId, rolId], map: "ux_tbl_usuarios_organizaciones")
  @@map("tbl_usuarios_organizaciones")
  @@schema("public")
}

model TblCliente {
  idCli              String               @id @default(dbgenerated("gen_random_uuid()")) @map("id_cli") @db.Uuid
  referencia         String?              @map("cli_referencia")
  activo             Boolean              @default(true) @map("cli_activo")
  creacion           DateTime             @default(now()) @map("cli_creacion") @db.Timestamptz(6)
  orgId              String               @map("org_id") @db.Uuid
  personaId          String               @map("cli_persona") @db.Uuid
  persona            TblPersona           @relation("TblClientePersona", fields: [personaId], references: [idPer])
  organizacion       TblOrganizacion      @relation(fields: [orgId], references: [idOrg])
  creditos           TblCredito[]
  tbl_notificaciones tbl_notificaciones[]
  rutas              TblRutaCliente[]

  @@unique([orgId, personaId], map: "ux_tbl_clientes_org_persona")
  @@unique([orgId, referencia], map: "ux_tbl_clientes_org_referencia")
  @@map("tbl_clientes")
  @@schema("public")
}

model TblRuta {
  idRut        String           @id @default(dbgenerated("gen_random_uuid()")) @map("id_rut") @db.Uuid
  nombre       String           @map("rut_nombre")
  descripcion  String?          @map("rut_descripcion")
  activa       Boolean          @default(true) @map("rut_activa")
  creacion     DateTime         @default(now()) @map("rut_creacion") @db.Timestamptz(6)
  usuId        String           @map("usu_id") @db.Uuid
  orgId        String           @map("org_id") @db.Uuid
  organizacion TblOrganizacion  @relation(fields: [orgId], references: [idOrg])
  usuario      TblUsuario       @relation(fields: [usuId], references: [idUsu])
  clientes     TblRutaCliente[]

  @@unique([orgId, nombre], map: "ux_tbl_rutas_org_nombre")
  @@index([usuId], map: "ix_tbl_rutas_usuario")
  @@map("tbl_rutas")
  @@schema("public")
}

model TblRutaCliente {
  idRcl    String     @id @default(dbgenerated("gen_random_uuid()")) @map("id_rcl") @db.Uuid
  activo   Boolean    @default(true) @map("rcl_activo")
  creacion DateTime   @default(now()) @map("rcl_creacion") @db.Timestamptz(6)
  rutId    String     @map("rut_id") @db.Uuid
  cliId    String     @map("cli_id") @db.Uuid
  cliente  TblCliente @relation(fields: [cliId], references: [idCli])
  ruta     TblRuta    @relation(fields: [rutId], references: [idRut])

  @@unique([rutId, cliId], map: "ux_tbl_rutas_clientes")
  @@index([cliId], map: "ix_tbl_rutas_clientes_cliente")
  @@map("tbl_rutas_clientes")
  @@schema("public")
}

model TblProductoCredito {
  idPcr       String       @id @default(dbgenerated("gen_random_uuid()")) @map("id_pcr") @db.Uuid
  nombre      String       @unique @map("pcr_nombre")
  frecuencia  String       @map("pcr_frecuencia")
  tasaInteres Decimal      @map("pcr_tasa_interes")
  creditos    TblCredito[]

  @@map("tbl_productos_creditos")
  @@schema("public")
}

model TblCategoriaGasto {
  idCga       String     @id @default(dbgenerated("gen_random_uuid()")) @map("id_cga") @db.Uuid
  nombre      String     @unique @map("cga_nombre")
  descripcion String?    @map("cga_descripcion")
  gastos      TblGasto[]

  @@map("tbl_categorias_gastos")
  @@schema("public")
}

model TblCaja {
  idCaj        String          @id @default(dbgenerated("gen_random_uuid()")) @map("id_caj") @db.Uuid
  nombre       String          @map("caj_nombre")
  tipo         String          @default("MENOR") @map("caj_tipo")
  activa       Boolean         @default(true) @map("caj_activa")
  creacion     DateTime        @default(now()) @map("caj_creacion") @db.Timestamptz(6)
  orgId        String          @map("org_id") @db.Uuid
  gasId        String?         @map("gas_id") @db.Uuid
  mon_id       String          @db.Uuid
  tbl_monedas  tbl_monedas     @relation(fields: [mon_id], references: [id_mon], onUpdate: NoAction, map: "fk_cajas_moneda")
  gasto        TblGasto?       @relation("TblCajaGasto", fields: [gasId], references: [idGas])
  organizacion TblOrganizacion @relation(fields: [orgId], references: [idOrg])
  gastos       TblGasto[]      @relation("TblGastoCaja")
  sesiones     TblSesionCaja[]

  @@unique([orgId, nombre], map: "ux_tbl_cajas_org_nombre")
  @@map("tbl_cajas")
  @@schema("public")
}

model TblGasto {
  idGas     String            @id @default(dbgenerated("gen_random_uuid()")) @map("id_gas") @db.Uuid
  fecha     DateTime          @default(now()) @map("gas_fecha") @db.Timestamptz(6)
  monto     Decimal           @map("gas_monto")
  cajId     String            @map("caj_id") @db.Uuid
  usuId     String            @map("usu_id") @db.Uuid
  cgaId     String            @map("cga_id") @db.Uuid
  cajas     TblCaja[]         @relation("TblCajaGasto")
  caja      TblCaja           @relation("TblGastoCaja", fields: [cajId], references: [idCaj])
  categoria TblCategoriaGasto @relation(fields: [cgaId], references: [idCga])
  usuario   TblUsuario        @relation(fields: [usuId], references: [idUsu])

  @@map("tbl_gastos")
  @@schema("public")
}

model TblSesionCaja {
  idSca           String              @id @default(dbgenerated("gen_random_uuid()")) @map("id_sca") @db.Uuid
  fechaApertura   DateTime            @default(now()) @map("sca_fecha_apertura") @db.Timestamptz(6)
  fechaCierre     DateTime?           @map("sca_fecha_cierre") @db.Timestamptz(6)
  montoInicial    Decimal             @default(0) @map("sca_monto_inicial")
  totalCobrado    Decimal             @default(0) @map("sca_total_cobrado")
  totalGasto      Decimal             @default(0) @map("sca_total_gasto")
  estado          String              @default("ABIERTA") @map("sca_estado")
  cajId           String              @map("caj_id") @db.Uuid
  usuId           String              @map("usu_id") @db.Uuid
  movimientosCaja TblMovimientoCaja[]
  caja            TblCaja             @relation(fields: [cajId], references: [idCaj])
  usuario         TblUsuario          @relation(fields: [usuId], references: [idUsu])

  @@map("tbl_sesiones_cajas")
  @@schema("public")
}

model TblMovimientoCaja {
  idMca          String          @id @default(dbgenerated("gen_random_uuid()")) @map("id_mca") @db.Uuid
  tipo           String          @map("mca_tipo")
  monto          Decimal         @map("mca_monto")
  referenciaId   String?         @map("mca_referencia_id") @db.Uuid
  referenciaTipo String?         @map("mca_referencia_tipo")
  creacion       DateTime        @default(now()) @map("mca_creacion") @db.Timestamptz(6)
  orgId          String          @map("org_id") @db.Uuid
  usuId          String          @map("usu_id") @db.Uuid
  scaId          String?         @map("sca_id") @db.Uuid
  organizacion   TblOrganizacion @relation(fields: [orgId], references: [idOrg])
  sesion         TblSesionCaja?  @relation(fields: [scaId], references: [idSca])
  usuario        TblUsuario      @relation(fields: [usuId], references: [idUsu])

  @@index([orgId, creacion(sort: Desc)], map: "ix_tbl_movimientos_cajas_org_fecha")
  @@map("tbl_movimientos_cajas")
  @@schema("public")
}

model TblCredito {
  idCre              String               @id @default(dbgenerated("gen_random_uuid()")) @map("id_cre") @db.Uuid
  total              Decimal              @map("cre_total")
  estado             String               @default("ACTIVO") @map("cre_estado")
  tasaInteres        Decimal              @map("cre_tasa_interes")
  interesTotal       Decimal              @map("cre_interes_total")
  totalPagar         Decimal              @map("cre_total_pagar")
  fechaInicio        DateTime             @map("cre_fecha_inicio") @db.Date
  fechaFin           DateTime             @map("cre_fecha_fin") @db.Date
  usuId              String               @map("usu_id") @db.Uuid
  pcrId              String               @map("pcr_id") @db.Uuid
  cliId              String               @map("cli_id") @db.Uuid
  mon_id             String               @db.Uuid
  tbl_monedas        tbl_monedas          @relation(fields: [mon_id], references: [id_mon], onUpdate: NoAction, map: "fk_creditos_moneda")
  cliente            TblCliente           @relation(fields: [cliId], references: [idCli])
  producto           TblProductoCredito   @relation(fields: [pcrId], references: [idPcr])
  usuario            TblUsuario           @relation(fields: [usuId], references: [idUsu])
  cuotas             TblCuota[]
  tbl_notificaciones tbl_notificaciones[]

  @@index([cliId, estado], map: "ix_tbl_creditos_cliente_estado")
  @@index([usuId, estado], map: "ix_tbl_creditos_usuario_estado")
  @@map("tbl_creditos")
  @@schema("public")
}

model TblCuota {
  idCuo            String         @id @default(dbgenerated("gen_random_uuid()")) @map("id_cuo") @db.Uuid
  numero           BigInt         @map("cuo_numero")
  valor            Decimal        @map("cuo_valor")
  totalPagado      Decimal        @default(0) @map("cuo_total_pagado")
  estado           String         @default("PENDIENTE") @map("cuo_estado")
  fechaVencimiento DateTime       @map("cuo_fecha_vencimiento") @db.Date
  creId            String         @map("cre_id") @db.Uuid
  credito          TblCredito     @relation(fields: [creId], references: [idCre])
  pagos            TblCuotaPago[]

  @@unique([creId, numero], map: "ux_tbl_cuotas_credito_numero")
  @@index([fechaVencimiento, estado], map: "ix_tbl_cuotas_vencimiento_estado")
  @@map("tbl_cuotas")
  @@schema("public")
}

model TblMedioPago {
  idMed            String    @id @default(dbgenerated("gen_random_uuid()")) @map("id_med") @db.Uuid
  nombre           String    @unique @map("med_nombre")
  tipo             String    @unique @map("med_tipo")
  proveedor        String?   @map("med_proveedor")
  referenciaCuenta String?   @map("med_referencia_cuenta")
  titular          String?   @map("med_titular")
  activo           Boolean   @default(true) @map("med_activo")
  creacion         DateTime  @default(now()) @map("med_creacion") @db.Timestamptz(6)
  actualizacion    DateTime  @default(now()) @map("med_actualizacion") @db.Timestamptz(6)
  pagos            TblPago[]

  @@map("tbl_medios_pagos")
  @@schema("public")
}

model TblPago {
  idPag                   String                   @id @default(dbgenerated("gen_random_uuid()")) @map("id_pag") @db.Uuid
  monto                   Decimal                  @map("pag_monto")
  fecha                   DateTime                 @default(now()) @map("pag_fecha") @db.Timestamptz(6)
  referencia              String?                  @map("pag_referencia")
  idempotencyLlave        String                   @unique @default(dbgenerated("gen_random_uuid()")) @map("pag_idempotency_llave") @db.Uuid
  estado                  String                   @default("REGISTRADO") @map("pag_estado")
  medId                   String                   @map("med_id") @db.Uuid
  mon_id                  String                   @db.Uuid
  cuotas                  TblCuotaPago[]
  tbl_notificaciones      tbl_notificaciones[]
  tbl_monedas             tbl_monedas              @relation(fields: [mon_id], references: [id_mon], onUpdate: NoAction, map: "fk_pagos_moneda")
  medioPago               TblMedioPago             @relation(fields: [medId], references: [idMed])
  tbl_wompi_transacciones tbl_wompi_transacciones?

  @@index([fecha(sort: Desc)], map: "ix_tbl_pagos_fecha")
  @@map("tbl_pagos")
  @@schema("public")
}

model TblCuotaPago {
  idCpa   String   @id @default(dbgenerated("gen_random_uuid()")) @map("id_cpa") @db.Uuid
  numero  BigInt?  @map("cpa_numero")
  capital Decimal  @default(0) @map("cpa_capital")
  interes Decimal  @default(0) @map("cpa_interes")
  total   Decimal  @map("cpa_total")
  cuoId   String   @map("cuo_id") @db.Uuid
  pagosId String   @map("pagos_id") @db.Uuid
  cuota   TblCuota @relation(fields: [cuoId], references: [idCuo])
  pago    TblPago  @relation(fields: [pagosId], references: [idPag])

  @@unique([cuoId, pagosId], map: "ux_tbl_cuotas_pagos")
  @@index([pagosId], map: "ix_tbl_cuotas_pagos_pago")
  @@map("tbl_cuotas_pagos")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tbl_monedas {
  id_mon                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mon_codigo              String                    @unique(map: "ux_tbl_monedas_codigo") @db.Char(3)
  mon_nombre              String                    @db.VarChar(80)
  mon_simbolo             String                    @db.VarChar(8)
  mon_decimales           BigInt                    @default(2)
  mon_activa              Boolean                   @default(true)
  mon_creacion            DateTime                  @default(now()) @db.Timestamptz(6)
  tbl_cajas               TblCaja[]
  tbl_creditos            TblCredito[]
  tbl_pagos               TblPago[]
  tbl_wompi_transacciones tbl_wompi_transacciones[]

  @@schema("public")
}

model tbl_notificaciones {
  id_not                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id                 String          @db.Uuid
  cli_id                 String          @db.Uuid
  cre_id                 String?         @db.Uuid
  pag_id                 String?         @db.Uuid
  not_tipo               String          @db.VarChar(50)
  not_canal              String          @db.VarChar(50)
  not_estado             String          @default("PENDIENTE") @db.VarChar(50)
  not_destinatario       String          @db.VarChar(180)
  not_referencia_externa String?         @db.VarChar(255)
  not_error              String?
  not_creacion           DateTime        @default(now()) @db.Timestamptz(6)
  not_envio              DateTime?       @db.Timestamptz(6)
  tbl_clientes           TblCliente      @relation(fields: [cli_id], references: [idCli], onDelete: Cascade, onUpdate: NoAction)
  tbl_creditos           TblCredito?     @relation(fields: [cre_id], references: [idCre], onDelete: Cascade, onUpdate: NoAction)
  tbl_organizaciones     TblOrganizacion @relation(fields: [org_id], references: [idOrg], onDelete: Cascade, onUpdate: NoAction)
  tbl_pagos              TblPago?        @relation(fields: [pag_id], references: [idPag], onDelete: Cascade, onUpdate: NoAction)

  @@index([cli_id], map: "idx_tbl_notificaciones_cli")
  @@index([org_id], map: "idx_tbl_notificaciones_org")
  @@index([cre_id], map: "idx_tbl_notificaciones_cre")
  @@index([not_estado], map: "idx_tbl_notificaciones_estado")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tbl_wompi_transacciones {
  id_wtr                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id                   String          @db.Uuid
  pag_id                   String?         @unique(map: "ux_tbl_wompi_transacciones_pago") @db.Uuid
  mon_id                   String          @db.Uuid
  wtr_tipo_pago            String          @db.VarChar(50)
  wtr_estado               String          @default("PENDIENTE") @db.VarChar(50)
  wtr_monto                Decimal         @db.Decimal(14, 2)
  wtr_monto_centavos       BigInt
  wtr_referencia           String          @unique(map: "ux_tbl_wompi_transacciones_referencia") @db.VarChar(120)
  wtr_wompi_transaction_id String?         @unique(map: "ux_tbl_wompi_transacciones_transaction") @db.VarChar(120)
  wtr_periodo_inicio       DateTime?       @db.Date
  wtr_periodo_fin          DateTime?       @db.Date
  wtr_creacion             DateTime        @default(now()) @db.Timestamptz(6)
  tbl_monedas              tbl_monedas     @relation(fields: [mon_id], references: [id_mon], onUpdate: NoAction)
  tbl_organizaciones       TblOrganizacion @relation(fields: [org_id], references: [idOrg], onDelete: Cascade, onUpdate: NoAction)
  tbl_pagos                TblPago?        @relation(fields: [pag_id], references: [idPag], onUpdate: NoAction)

  @@index([org_id, wtr_creacion(sort: Desc)], map: "ix_tbl_wompi_transacciones_org_creacion")
  @@index([wtr_estado], map: "ix_tbl_wompi_transacciones_estado")
  @@schema("public")
}
